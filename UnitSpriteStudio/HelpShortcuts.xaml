<Window x:Class="UnitSpriteStudio.HelpShortcuts"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UnitSpriteStudio"
        mc:Ignorable="d"
        Title="Shortcuts" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen" WindowStyle="ToolWindow">
	<StackPanel Orientation="Horizontal">
		<StackPanel>
			<Label FontSize="20">Global</Label>
			<Label>Change unit direction: Numpad 1 to 9</Label>
			<Label>Quick select layer: Number 1 to 9</Label>
			<Label>Reload from disk: F5</Label>
			<Label FontSize="20">Animation</Label>
			<Label>Previous frame: Numpad - or -</Label>
			<Label>Next frame: Numpad + or =</Label>
			<Label FontSize="20">Tools</Label>
			<Label>Paint: B or P</Label>
			<Label>Copy Colour: O</Label>
			<Label>Pixel Selection: A</Label>
			<Label>Box Selection: S</Label>
			<Label>Lasso Selection: D</Label>
			<Label>Color Selection: F</Label>
			<Label>Area Selection: G</Label>
			<Label>Checkered background: Ctrl+B</Label>
			<Label>Grid: Ctrl+G</Label>
		</StackPanel>
		<StackPanel>
			<Label FontSize="20">Colour palette</Label>
			<Label>Lighter colour: /</Label>
			<Label>Darker colour: *</Label>
			<Label>Shift colour for all layers: Shift-Click</Label>
			<Label>Copy colour: Alt+(Left|Right|Middle)Click</Label>
			<Label FontSize="20">Selection</Label>
			<Label>Erase: Delete</Label>
			<Label>Fill: Insert</Label>
			<Label>Move: Ctrl+Click&amp;Drag</Label>
			<Label>Add to selection: Hold Shift</Label>
			<Label>Subtract from selection: Hold Alt</Label>
		</StackPanel>

	</StackPanel>
</Window>
